PORT=4000
# Local dev default shown below. In production (Render/Vercel env vars),
# set this to your live domain: https://www.electricianprep.co.uk
CLIENT_URL=http://localhost:5173
JWT_SECRET=change_this_to_a_long_random_string

# Postgres (Neon) — persistent user + activity storage.
# Get this from your Neon project → Connect → Connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_WEEKLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_LIFETIME=price_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Google Sign-In
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Admin emails (comma-separated) — include admin@example.com if you run
# `node seed-demo.js`, otherwise that demo account loses admin on next login
ADMIN_EMAILS=you@example.com,admin@example.com

# AI — Groq is recommended: genuinely free, no credit card, no billing
# quirks. Get a key in 30 seconds at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=groq
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-6

# Email (SMTP) — for welcome emails, password reset, payment notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=support@cscsprep.co.uk
